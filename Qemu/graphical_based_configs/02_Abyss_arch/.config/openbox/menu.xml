<?xml version="1.0" encoding="utf-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Openbox">
    <item label="Terminal">
      <action name="Execute"><command>alacritty</command></action>
    </item>
    <item label="Tor Browser">
      <action name="Execute"><command>torbrowser-launcher</command></action>
    </item>
    <item label="Files">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="Files - yazi">
      <action name="Execute"><command>alacritty -e yazi</command></action>
    </item>
    <item label="Run">
      <action name="Execute"><command>dmenu_run</command></action>
    </item>
    <separator/>
    <item label="Image Viewer">
      <action name="Execute"><command>imv</command></action>
    </item>
    <item label="Media Player">
      <action name="Execute"><command>mpv</command></action>
    </item>
    <separator/>
    <menu id="client-list-menu"/>
    <separator/>
    <menu id="system-menu" label="System">
      <item label="Reconfigure">
        <action name="Reconfigure"/>
      </item>
      <item label="Restart">
        <action name="Restart"/>
      </item>
      <item label="Edit Menu">
        <action name="Execute"><command>alacritty -e nvim ~/.config/openbox/menu.xml</command></action>
      </item>
      <item label="Edit rc.xml">
        <action name="Execute"><command>alacritty -e nvim ~/.config/openbox/rc.xml</command></action>
      </item>
      <separator/>
      <item label="Lock/Suspend">
        <action name="Execute"><command>systemctl suspend</command></action>
      </item>
      <item label="Reboot">
        <action name="Execute"><command>systemctl reboot</command></action>
      </item>
      <item label="Shutdown">
        <action name="Execute"><command>systemctl poweroff</command></action>
      </item>
    </menu>
    <separator/>
    <item label="Exit">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
